# Copy to .env and fill secrets locally. Do not commit .env.

GOOGLE_CLOUD_PROJECT=all-things-agents-507211
# Gemini 3.5 Flash on Vertex requires location=global (not us-central1).
GOOGLE_CLOUD_LOCATION=global
FIRESTORE_PROJECT=all-things-agents-507211
TMC_USE_VERTEXAI=1
GOOGLE_GENAI_USE_VERTEXAI=true
# Task-scoped routing (see tmc_gate/model_router.py). Floor remains Gemini 3.5+.
TMC_GEMINI_MODEL=gemini-3.7-flash
# Optional per-task overrides:
# TMC_GEMINI_MODEL_OVERNIGHT=gemini-3.7-flash
# TMC_GEMINI_MODEL_QUOTE=gemini-3.7-flash
# TMC_GEMINI_MODEL_QUOTE_RETRY=gemini-3.5-flash
# TMC_GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# Optional local Gemini API key (Vertex is preferred on Cloud Functions)
GOOGLE_API_KEY=

# AIMLAPI — OpenAI-compatible Gemini fallback when Vertex fails
AIMLAPI_KEY=
# Optional: AIMLAPI_BASE=https://api.aimlapi.com/v1
# Optional: TMC_AIMLAPI_MODEL=google/gemini-3.5-flash

# Model Armor (regional template; keep separate from Vertex global)
MODEL_ARMOR_ENABLED=1
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=projects/all-things-agents-507211/locations/us-central1/templates/tmc-gate-armor

# Hour-0 service letters for /health
TMC_EARTH_ENGINE=enabled
TMC_BIGQUERY=enabled
TMC_PUBSUB=enabled
TMC_MODEL_ARMOR=enabled
TMC_FIRESTORE=enabled
TMC_SECRET_MANAGER=enabled
TMC_CLOUD_STORAGE=enabled

TMC_CLOCK=wall
TMC_ADK_ORCHESTRATE=1
