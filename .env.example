# Copy to .env and fill GOOGLE_API_KEY. Do not commit .env.

GOOGLE_CLOUD_PROJECT=all-things-agents-507211
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_PROJECT=all-things-agents-507211

# Gemini — paste locally only (also store in Secret Manager; see README)
GOOGLE_API_KEY=

# Model Armor (created)
MODEL_ARMOR_ENABLED=1
MODEL_ARMOR_TEMPLATE=projects/all-things-agents-507211/locations/us-central1/templates/tmc-gate-armor

# Hour-0 service letters for /health
TMC_EARTH_ENGINE=enabled
TMC_BIGQUERY=enabled
TMC_PUBSUB=enabled
TMC_MODEL_ARMOR=enabled
TMC_FIRESTORE=enabled
TMC_SECRET_MANAGER=enabled
TMC_CLOUD_STORAGE=enabled

TMC_CLOCK=wall
